# Django Configuration
DEBUG=False
SECRET_KEY=your-production-secret-key-change-this-to-something-very-secure
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/legal_backend
POSTGRES_DB=legal_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Security Settings for Production
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Set to True when using HTTPS in production
# SECURE_SSL_REDIRECT=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# Media and Static Files
MEDIA_URL=/media/
STATIC_URL=/static/