{
	"info": {
		"_postman_id": "legal-practice-auth-api-collection",
		"name": "Legal Practice Management API - With Authentication",
		"description": "Complete Postman collection for testing the Legal Practice Management Django REST API with JWT authentication and role-based authorization.\n\n## Authentication System\nThis API uses JWT (JSON Web Token) authentication with role-based permissions:\n- **Admin Lawyers**: Full access to all data and operations\n- **Regular Lawyers**: Limited access to assigned mandates and own time entries\n\n## Getting Started\n1. Import this collection and environment into Postman\n2. Start Django server: `python manage.py runserver`\n3. Create demo users: `python manage.py create_demo_users --clear`\n4. Use the Authentication folder to login and get tokens\n5. Test different access levels with admin vs regular user tokens\n\n## Demo Users\n- **Admin**: sarah.wilson@lawfirm.com / admin123\n- **Regular**: michael.chen@lawfirm.com / lawyer123\n- **Junior**: emma.rodriguez@lawfirm.com / lawyer123",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-refresh token if expired",
					"const access_token = pm.environment.get('access_token');",
					"const refresh_token = pm.environment.get('refresh_token');",
					"",
					"if (!access_token && refresh_token) {",
					"    console.log('No access token, attempting refresh...');",
					"    ",
					"    pm.sendRequest({",
					"        url: pm.environment.get('base_url') + '/auth/token/refresh/',",
					"        method: 'POST',",
					"        header: {",
					"            'Content-Type': 'application/json'",
					"        },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                refresh: refresh_token",
					"            })",
					"        }",
					"    }, function (err, response) {",
					"        if (err) {",
					"            console.log('Token refresh failed:', err);",
					"        } else if (response.code === 200) {",
					"            const data = response.json();",
					"            pm.environment.set('access_token', data.access);",
					"            if (data.refresh) {",
					"                pm.environment.set('refresh_token', data.refresh);",
					"            }",
					"            console.log('Token refreshed successfully');",
					"        } else {",
					"            console.log('Token refresh failed with status:', response.code);",
					"            pm.environment.unset('access_token');",
					"            pm.environment.unset('refresh_token');",
					"        }",
					"    });",
					"}"
				]
			}
		}
	],
