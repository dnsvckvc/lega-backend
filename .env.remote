# Remote Server Environment Configuration
# Copy this file to .env on your remote server and update the values

# Basic Django Configuration
DEBUG=True
SECRET_KEY=your-production-secret-key-change-this-immediately

# IMPORTANT: Replace YOUR_SERVER_IP with your actual server IP address
# Example: ALLOWED_HOSTS=192.168.1.100,your-domain.com
ALLOWED_HOSTS=YOUR_SERVER_IP,localhost,127.0.0.1

# Database Configuration
# IMPORTANT: Use a secure, randomly generated password for PostgreSQL
# This password was generated using: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Change this to a different secure password for production
POSTGRES_DB=legal_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=_vWNOWZrkXAHtLhh4yGVvfd-FceBQ2uj2fQjwLAX4e4
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS Configuration for API Access
# Add your local machine IP and any frontend origins
# Example: CORS_ALLOWED_ORIGINS=http://192.168.1.100:3000,http://localhost:3000,http://YOUR_CLIENT_IP:3000
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:3000,http://YOUR_SERVER_IP:5173,http://YOUR_SERVER_IP:8080,http://localhost:3000,http://127.0.0.1:3000

# For testing, you can temporarily enable all origins (NOT for production)
# CORS_ALLOW_ALL_ORIGINS=True

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Security Settings (keep these as False for development)
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0